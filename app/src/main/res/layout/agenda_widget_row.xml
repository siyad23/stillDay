<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingBottom="8dp" android:baselineAligned="false">
    <FrameLayout android:layout_width="78dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp">
        <ImageView android:id="@+id/widget_day_background" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/widget_date" android:scaleType="fitXY" android:contentDescription="@null" />
        <LinearLayout android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/widget_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#536F5E" android:maxLines="1" />
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="11sp" android:textColor="#536F5E" android:maxLines="2" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <ImageView android:id="@+id/widget_card_background" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/widget_card" android:scaleType="fitXY" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/widget_category" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
